{
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "maxRetryCount": 0,
        "maxRunDuration": "7200s",
        "computeResource": {
          "cpuMilli": 12000,
          "memoryMib": 83968
        },
        "volumes": [
          {
            "gcs": { "remotePath": "__BUCKET__/eval-out" },
            "mountPath": "/mnt/disks/out"
          }
        ],
        "runnables": [
          {
            "container": {
              "imageUri": "__IMAGE_URI__",
              "entrypoint": "python3",
              "commands": [
                "-u", "eval_vllm.py",
                "--model", "__MODEL__",
                __REASONING_FLAG__
                __THINKING_FLAG__
                __QUANT_FLAG__
                "--data", "data/benchmark_dataset.csv",
                "--limit", "__LIMIT__",
                "--repo-id", "__REPO__",
                "--out", "/mnt/disks/out/__OUT__",
                "--pool-size", "64",
                "--gpu-mem-util", "0.90",
                "--max-turns", "12",
                "--max-model-len", "16384"
              ],
              "options": "--privileged"
            },
            "environment": {
              "variables": { "HF_HUB_ENABLE_HF_TRANSFER": "1" },
              "secretVariables": {
                "HF_TOKEN": "projects/329582102589/secrets/hf-token/versions/latest"
              }
            }
          }
        ]
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "installGpuDrivers": true,
        "policy": {
          "machineType": "a2-highgpu-1g",
          "provisioningModel": "STANDARD",
          "bootDisk": { "sizeGb": 120 }
        }
      }
    ]
  },
  "logsPolicy": { "destination": "CLOUD_LOGGING" }
}

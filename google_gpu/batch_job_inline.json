{
  "taskGroups": [
    {
      "taskCount": 1,
      "parallelism": 1,
      "taskSpec": {
        "maxRetryCount": 1,
        "maxRunDuration": "900s",
        "computeResource": {
          "cpuMilli": 12000,
          "memoryMib": 83968
        },
        "runnables": [
          {
            "container": {
              "imageUri": "pytorch/pytorch:2.4.1-cuda12.1-cudnn9-runtime",
              "entrypoint": "/bin/bash",
              "commands": [
                "-c",
                "echo  | base64 -d > /tmp/hello_gpu.py && python -u /tmp/hello_gpu.py"
              ],
              "options": "--privileged"
            }
          }
        ]
      }
    }
  ],
  "allocationPolicy": {
    "instances": [
      {
        "installGpuDrivers": true,
        "policy": {
          "machineType": "a2-highgpu-1g",
          "provisioningModel": "STANDARD"
        }
      }
    ]
  },
  "logsPolicy": {
    "destination": "CLOUD_LOGGING"
  }
}
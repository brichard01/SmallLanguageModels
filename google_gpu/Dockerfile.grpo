# GRPO/QLoRA fine-tuning of Qwen3-4B on the HS-code env reward, for 1x A100 40GB.
# torch >=2.5 is required: transformers 5.x imports torch.distributed.tensor.DTensor,
# which did not exist in torch 2.4.1. 2.6.0/cu124 has it and is A100-supported.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime

# Unbuffered stdout so training logs stream to Cloud Logging in real time.
ENV PYTHONUNBUFFERED=1
ENV HF_XET_HIGH_PERFORMANCE=1

# git: to pip-install TRL from source. build-essential (gcc): triton JIT-compiles
# a CUDA helper at import time (via bitsandbytes) and needs a C compiler.
RUN apt-get update && apt-get install -y --no-install-recommends git build-essential \
    && rm -rf /var/lib/apt/lists/*

# Heavy deps. TRL is installed from git main because GRPOTrainer's
# environment_factory (per-rollout stateful env + env-owned reward) is only on
# main, not in the stable release yet. transformers>=4.51 is needed for Qwen3.
RUN pip install --no-cache-dir --upgrade \
      "transformers>=4.51" \
      "accelerate>=0.34" \
      "datasets>=2.20" \
      "peft>=0.13" \
      "bitsandbytes>=0.43" \
      "hf_transfer" \
      "jmespath" \
      "git+https://github.com/huggingface/trl.git"

# Build context is the repo root (see cloudbuild.grpo.yaml), so these paths are
# relative to the project root. grpo_hscode.py lives in training_methods/ but is
# flattened into /app so it can `from hscode_env import ...` and read data/ by
# relative path, exactly as it does locally.
WORKDIR /app
COPY hscode_env.py training_methods/grpo_hscode.py training_methods/distill_train.py ./
COPY data/harmonized_system_by_parent.csv data/sections_prepared.csv data/benchmark_dataset.csv ./data/

CMD ["python", "-u", "grpo_hscode.py"]

# Whole-model evaluation on the HS-code task with vLLM, on 1x A100 40GB.
# The model is NOT baked into the image -- it is passed as a runtime arg
# (--model <hf-id>) by the Batch job, so a new checkpoint needs no rebuild.
# The official vLLM image already ships a matched torch + CUDA + AWQ kernels and
# a recent transformers, so we only add datasets on top.
FROM vllm/vllm-openai:latest

ENV PYTHONUNBUFFERED=1
ENV HF_HUB_ENABLE_HF_TRANSFER=1

RUN pip install --no-cache-dir "datasets>=2.20" "hf_transfer"

# Build context is the repo root (see cloudbuild.eval.yaml). Flatten the script +
# env into /app so `from hscode_env import ...` and the data/ relative paths work,
# exactly as they do locally. eval_vllm.py detects this flattened layout.
WORKDIR /app
COPY hscode_env.py benchmarks/eval_vllm.py ./
COPY data/harmonized_system_by_parent.csv data/sections_prepared.csv data/benchmark_dataset.csv ./data/

# vLLM's image sets an api-server entrypoint; clear it so the Batch job's
# command (python eval_vllm.py ...) runs instead.
ENTRYPOINT []
CMD ["python3", "-u", "eval_vllm.py", "--help"]
